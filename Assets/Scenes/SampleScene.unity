  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "========================================================================\n                     
    \xC1RVORE DE TECNOLOGIAS - SATELLIS\n========================================================================\n\n
    [1] RAMO DE MINERA\xC7\xC3O (Produ\xE7\xE3o de Recursos)\n -----------------------------------------------------------------------\n
    \u2022 Nv 1: Minas Superficiais      | Custo: 100 Metal  | Tempo: 2 Ticks\n \u2022
    Nv 2: Lab. de Pesquisa        | Custo: 250 Metal  | Tempo: 4 Ticks\n \u2022 Nv
    3: Minas Profundas         | Custo: 600 Metal  | Tempo: 8 Ticks\n \u2022 Nv 4:
    Reator Nuclear          | Custo: 1500 Metal | Tempo: 16 Ticks\n \u2022 Nv 5:
    Sintetizador de Comp.   | Custo: 4000 Metal | Tempo: 32 Ticks\n\n [2] RAMO DE
    COMUNICA\xC7\xC3O (Intelig\xEAncia e Sensores)\n -----------------------------------------------------------------------\n
    \u2022 Nv 1: Radar                   | Custo: 120 Metal  | Tempo: 2 Ticks\n \u2022
    Nv 2: Multiplex               | Custo: 300 Metal  | Tempo: 4 Ticks\n \u2022 Nv
    3: \xCDons                    | Custo: 700 Metal  | Tempo: 8 Ticks\n \u2022 Nv
    4: Phalanx                 | Custo: 1800 Metal | Tempo: 16 Ticks\n \u2022 Nv
    5: Refletor                | Custo: 4500 Metal | Tempo: 32 Ticks\n\n [3] RAMO
    DE NAVES (Infraestrutura Militar)\n -----------------------------------------------------------------------\n
    \u2022 Nv 1: Hangar                  | Custo: 150 Metal  | Tempo: 2 Ticks\n \u2022
    Nv 2: Blindagem               | Custo: 400 Metal  | Tempo: 4 Ticks\n \u2022 Nv
    3: Escudo                  | Custo: 900 Metal  | Tempo: 8 Ticks  <- Requer Comunica\xE7\xE3o
    Nv 3\n \u2022 Nv 4: Armas                   | Custo: 2200 Metal | Tempo: 16 Ticks
    <- Requer Comunica\xE7\xE3o Nv 3\n \u2022 Nv 5: Estaleiro               | Custo:
    5000 Metal | Tempo: 32 Ticks <- Requer Minera\xE7\xE3o Nv 5\n\n [4] RAMO DE DESLOCAMENTO
    (Propuls\xE3o e Viagem)\n -----------------------------------------------------------------------\n
    \u2022 Nv 1: Combust\xE3o               | Custo: 130 Metal  | Tempo: 2 Ticks 
    <- Requer Naves Nv 1\n \u2022 Nv 2: Impuls\xE3o                | Custo: 350 Metal 
    | Tempo: 4 Ticks\n \u2022 Nv 3: Plasma                  | Custo: 800 Metal  |
    Tempo: 8 Ticks\n \u2022 Nv 4: Gravita\xE7\xE3o              | Custo: 2000 Metal
    | Tempo: 16 Ticks\n \u2022 Nv 5: Hiperespa\xE7o             | Custo: 6000 Metal
    | Tempo: 32 Ticks <- Requer Deslocamento Nv 4\n                                                                         
    e Minera\xE7\xE3o Nv 4\n========================================================================\n"
